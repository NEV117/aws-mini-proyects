# Copy to terraform.tfvars and adjust.

region = "us-east-1"
# Defaults to the region's second AZ (us-east-1b). It must offer mac2.metal (see README).
# availability_zone = "us-east-1c"

# Optional: use a dedicated host you allocated yourself (its AZ is then used).
# Terraform will not release it on destroy.
# host_id = "h-0123456789abcdef0"

# Leave unset to use the default VPC's default subnet in availability_zone
# subnet_id = "subnet-xxxxxxxx"

remote_username      = "myuser"
remote_user_password = "MySecure#Pass2026" # letters, digits and @#%^&* only

# Optional: open VNC to your IP instead of using only the SSM tunnel
# allowed_vnc_cidr = "203.0.113.10/32"

# SSM interface VPC endpoints (on by default, billed hourly). Turn off if the VPC
# already has ssm, ssmmessages and ec2messages endpoints with private DNS.
# enable_ssm_vpc_endpoints = false

# Optional: newer macOS
# mac_ami_ssm_parameter = "/aws/service/ec2-macos/tahoe/arm64_mac/latest/image_id"

tags = {
  Owner = "you@example.com"
}
